      "note": "an alert marker is case-insensitive",
      "md": "> [!tip]\n> lower\n",
      "html": "<div class=\"markdown-alert markdown-alert-tip\"><p class=\"markdown-alert-title\">Tip</p><p>lower</p></div>"
    },
    {
      "note": "an alert with a custom title",
      "md": "> [!WARNING] Mind the gap\n> careful\n",
      "html": "<div class=\"markdown-alert markdown-alert-warning\"><p class=\"markdown-alert-title\">Mind the gap</p><p>careful</p></div>"
    },
    {
      "note": "an alert holding blocks",
      "md": "> [!NOTE]\n> para\n>\n> - item\n",
      "html": "<div class=\"markdown-alert markdown-alert-note\"><p class=\"markdown-alert-title\">Note</p><p>para</p><ul><li>item</li></ul></div>"
    },
    {
      "note": "an unknown alert type is a plain quote",
      "md": "> [!FOO]\n> body\n",
      "html": "<blockquote><p>[!FOO] body</p></blockquote>"
    },
    {
      "note": "an alert marker must open the quote",
      "md": "> text\n> [!NOTE]\n",
      "html": "<blockquote><p>text [!NOTE]</p></blockquote>"
    },
    {
      "note": "a footnote",
      "md": "Hi[^1].\n\n[^1]: A greeting.\n",
      "html": "<p>Hi<sup class=\"footnote-ref\"><a href=\"#fn-1\" id=\"user-content-fnref-1\">1</a></sup>.</p><section class=\"footnotes\"><ol><li id=\"user-content-fn-1\"><p>A greeting. <a class=\"footnote-backref\" href=\"#fnref-1\">↩</a></p></li></ol></section>"
    },
    {
      "note": "a named footnote referenced twice",
      "md": "A[^n] and B[^n].\n\n[^n]: Shared.\n",
      "html": "<p>A<sup class=\"footnote-ref\"><a href=\"#fn-n\" id=\"user-content-fnref-n\">1</a></sup> and B<sup class=\"footnote-ref\"><a href=\"#fn-n\" id=\"user-content-fnref-n-2\">1</a></sup>.</p><section class=\"footnotes\"><ol><li id=\"user-content-fn-n\"><p>Shared. <a class=\"footnote-backref\" href=\"#fnref-n\">↩</a> <a class=\"footnote-backref\" href=\"#fnref-n-2\">↩<sup class=\"footnote-ref\">2</sup></a></p></li></ol></section>"
    },
    {
      "note": "footnotes number in reference order",
      "md": "x[^b] y[^a]\n\n[^a]: Alpha.\n[^b]: Beta.\n",
      "html": "<p>x<sup class=\"footnote-ref\"><a href=\"#fn-b\" id=\"user-content-fnref-b\">1</a></sup> y<sup class=\"footnote-ref\"><a href=\"#fn-a\" id=\"user-content-fnref-a\">2</a></sup></p><section class=\"footnotes\"><ol><li id=\"user-content-fn-b\"><p>Beta. <a class=\"footnote-backref\" href=\"#fnref-b\">↩</a></p></li><li id=\"user-content-fn-a\"><p>Alpha. <a class=\"footnote-backref\" href=\"#fnref-a\">↩</a></p></li></ol></section>"
    },
    {
      "note": "an unreferenced definition is dropped",
      "md": "text[^1]\n\n[^1]: used\n[^2]: unused\n",
      "html": "<p>text<sup class=\"footnote-ref\"><a href=\"#fn-1\" id=\"user-content-fnref-1\">1</a></sup></p><section class=\"footnotes\"><ol><li id=\"user-content-fn-1\"><p>used <a class=\"footnote-backref\" href=\"#fnref-1\">↩</a></p></li></ol></section>"
    },
    {
      "note": "a reference without a definition stays literal",
      "md": "text[^missing]\n",
      "html": "<p>text[^missing]</p>"
    },
    {
      "note": "a footnote with continuation blocks",
      "md": "t[^1]\n\n[^1]: First para.\n\n    Second para.\n",
      "html": "<p>t<sup class=\"footnote-ref\"><a href=\"#fn-1\" id=\"user-content-fnref-1\">1</a></sup></p><section class=\"footnotes\"><ol><li id=\"user-content-fn-1\"><p>First para.</p><p>Second para. <a class=\"footnote-backref\" href=\"#fnref-1\">↩</a></p></li></ol></section>"
    },
    {
      "note": "frontmatter is not part of the body",
      "md": "---\ntitle: T\ntags: [a, b]\n---\n\n# Body\n",
      "html": "<h1 id=\"user-content-body\">Body<a class=\"anchor\" href=\"#body\"></a></h1>"
    },
    {
      "note": "a leading rule without keys is not frontmatter",
      "md": "---\n\nintro\n\n---\n",
      "html": "<hr><p>intro</p><hr>"
    },
    {
      "note": "a wikilink",
      "md": "see [[Other Note]]\n",
      "html": "<p>see <a class=\"wikilink\" href=\"Other%20Note.md\">Other Note</a></p>",
      "diverges": {
        "side": "server",
        "reason": "wikilinks are read for Obsidian vaults on the client only; the daemon's comrak runs without its wikilink extension, so the server fallback shows them as literal text"
      }
    },
    {
      "note": "a wikilink with an alias",
      "md": "see [[target|the alias]]\n",
      "html": "<p>see <a class=\"wikilink\" href=\"target.md\">the alias</a></p>",
      "diverges": {
        "side": "server",
        "reason": "wikilinks are read for Obsidian vaults on the client only; the daemon's comrak runs without its wikilink extension, so the server fallback shows them as literal text"
      }
    },
    {
      "note": "a wikilink to a heading",
      "md": "see [[notes#Setup]]\n",
      "html": "<p>see <a class=\"wikilink\" href=\"notes.md#setup\">notes#Setup</a></p>",
      "diverges": {
        "side": "server",
        "reason": "wikilinks are read for Obsidian vaults on the client only; the daemon's comrak runs without its wikilink extension, so the server fallback shows them as literal text"
      }
    },
    {
      "note": "an image embed",
      "md": "![[plot.png]]\n",
      "html": "<p><img alt=\"plot.png\" src=\"plot.png\"></p>",
      "diverges": {
        "side": "server",
        "reason": "wikilinks are read for Obsidian vaults on the client only; the daemon's comrak runs without its wikilink extension, so the server fallback shows them as literal text"
      }
    },
    {
      "note": "a non-image embed is a file link",
      "md": "![[notes.md]]\n",
      "html": "<p><a class=\"wikilink wikilink-embed\" href=\"notes.md\">notes.md</a></p>",
      "diverges": {
        "side": "server",
        "reason": "wikilinks are read for Obsidian vaults on the client only; the daemon's comrak runs without its wikilink extension, so the server fallback shows them as literal text"
      }
    },
    {
      "note": "a destination's escapes and unicode are href-escaped",
      "md": "[a](/x\\_y) [b](/é) [c](/a b)\n",
      "html": "<p><a href=\"/x_y\">a</a> <a href=\"/%C3%A9\">b</a> [c](/a b)</p>"
    },
    {
      "note": "heading ids drop symbols and keep double dashes",
      "md": "# A &amp; B 🎉 _x_\n",
      "html": "<h1 id=\"user-content-a--b--x\">A &amp; B 🎉 <em>x</em><a class=\"anchor\" href=\"#a--b--x\"></a></h1>"
    },
    {
      "note": "heading ids dedupe across levels",
      "md": "# A\n## A\n### a\n",
      "html": "<h1 id=\"user-content-a\">A<a class=\"anchor\" href=\"#a\"></a></h1><h2 id=\"user-content-a-1\">A<a class=\"anchor\" href=\"#a-1\"></a></h2><h3 id=\"user-content-a-2\">a<a class=\"anchor\" href=\"#a-2\"></a></h3>"
    },
    {
      "note": "a hard break in a setext heading",
      "md": "a\\\nb\n===\n",
      "html": "<h1 id=\"user-content-a-b\">a<br>b<a class=\"anchor\" href=\"#a-b\"></a></h1>"
    },
    {
      "note": "a multi-line setext heading",
      "md": "a\nb\n===\n",
      "html": "<h1 id=\"user-content-a-b\">a b<a class=\"anchor\" href=\"#a-b\"></a></h1>"
    },
    {
      "note": "an escaped closing hash is heading text",
      "md": "# a \\#\n",
      "html": "<h1 id=\"user-content-a-\">a #<a class=\"anchor\" href=\"#a-\"></a></h1>"
    },
    {
      "note": "an image and math feed the heading id",
      "md": "# ![i](a.png) t $x$\n",
      "html": "<h1 id=\"user-content-i-t-x\"><img alt=\"i\" src=\"a.png\"> t <span>x</span><a class=\"anchor\" href=\"#i-t-x\"></a></h1>"
    },
    {
      "note": "an empty list item",
      "md": "-\n- b\n",
      "html": "<ul><li></li><li>b</li></ul>"
    },
    {
      "note": "an ordered list starting at 0",
      "md": "0. a\n1. b\n",
      "html": "<ol start=\"0\"><li>a</li><li>b</li></ol>"
    },
    {
      "note": "a loose task list keeps the box outside the paragraph",
      "md": "- [ ] a\n\n- [x] b\n",
      "html": "<ul class=\"contains-task-list\"><li class=\"task-list-item\"><span class=\"md-task\" data-task=\"todo\"></span><p>a</p></li><li class=\"task-list-item\"><span class=\"md-task\" data-task=\"done\"></span><p>b</p></li></ul>"
    },
    {
      "note": "two blockquotes split by a blank line",
      "md": "> a\n\n> b\n",
      "html": "<blockquote><p>a</p></blockquote><blockquote><p>b</p></blockquote>"
    },
    {
      "note": "a lazy continuation inside a quoted list",
      "md": "> - a\nb\n",
      "html": "<blockquote><ul><li>a b</li></ul></blockquote>"
    },
    {
      "note": "an alert with only its marker",
      "md": "> [!NOTE]\n",
      "html": "<div class=\"markdown-alert markdown-alert-note\"><p class=\"markdown-alert-title\">Note</p></div>"
    },
    {
      "note": "an alert inside a list item",
      "md": "- > [!TIP]\n  > inner\n",
      "html": "<ul><li><div class=\"markdown-alert markdown-alert-tip\"><p class=\"markdown-alert-title\">Tip</p><p>inner</p></div></li></ul>"
    },
    {
      "note": "an alert inside a blockquote",
      "md": "> > [!NOTE]\n> > x\n",
      "html": "<blockquote><div class=\"markdown-alert markdown-alert-note\"><p class=\"markdown-alert-title\">Note</p><p>x</p></div></blockquote>"
    },
    {
      "note": "an alert marker needs the space after >",
      "md": ">[!NOTE]\n>body\n",
      "html": "<blockquote><p>[!NOTE] body</p></blockquote>"
    },
    {
      "note": "an alert title is plain text",
      "md": "> [!NOTE] **Bold** title\n> body\n",
      "html": "<div class=\"markdown-alert markdown-alert-note\"><p class=\"markdown-alert-title\">**Bold** title</p><p>body</p></div>"
    },
    {
      "note": "a code span across lines",
      "md": "`a\nb`\n",
      "html": "<p><code>a b</code></p>"
    },
    {
      "note": "strikethrough across a soft break",
      "md": "~~a\nb~~\n",
      "html": "<p><del>a b</del></p>"
    },
    {
      "note": "three tildes inline are text",
      "md": "a ~~~x~~~ b\n",
      "html": "<p>a ~~~x~~~ b</p>"
    },
    {
      "note": "an autolink keeps its query",
      "md": "https://ex.com/p?q=1&r=2\n",
      "html": "<p><a href=\"https://ex.com/p?q=1&amp;r=2\">https://ex.com/p?q=1&amp;r=2</a></p>"
    },
    {
      "note": "a bare email drops a trailing dot",
      "md": "first.last@ex.co.uk.\n",
      "html": "<p><a href=\"mailto:first.last@ex.co.uk\">first.last@ex.co.uk</a>.</p>"
    },
    {
      "note": "a bare www link drops a trailing underscore",
      "md": "www.ex.com/a_b_\n",
      "html": "<p><a href=\"http://www.ex.com/a_b\">www.ex.com/a_b</a>_</p>"
    },
    {
      "note": "an angle www is not an autolink",
      "md": "<www.ex.com>\n",
      "html": "<p>&lt;www.ex.com&gt;</p>"
    },
    {
      "note": "a nested link leaves the outer as text",
      "md": "[a [b](/b) c](/a)\n",
      "html": "<p>[a <a href=\"/b\">b</a> c](/a)</p>"
    },
    {
      "note": "a javascript link loses its href",
      "md": "[x](javascript:alert(1))\n",
      "html": "<p><a>x</a></p>"
    },
    {
      "note": "a data image loses its src",
      "md": "![x](data:image/png;base64,AAAA)\n",
      "html": "<p><img alt=\"x\"></p>"
    },
    {
      "note": "a file link loses its href",
      "md": "[f](file:///etc/passwd)\n",
      "html": "<p><a>f</a></p>"
    },
    {
      "note": "an indented fence strips its indent",
      "md": "  ```\n  a\n   b\n  ```\n",
      "html": "<pre><code>a b </code></pre>"
    },
    {
      "note": "an empty fence",
      "md": "```\n```\n",
      "html": "<pre><code></code></pre>"
    },
    {
      "note": "a fence of one blank line",
      "md": "```\n\n```\n",
      "html": "<pre><code> </code></pre>"
    },
    {
      "note": "an indented block keeps inner blank lines",
      "md": "    a\n\n    b\n\n\npara\n",
      "html": "<pre><code>a b </code></pre><p>para</p>"
    },
    {
      "note": "an HTML block runs to the blank line",
      "md": "<div>x</div>\npara\n",
      "html": "<div>x</div>para"
    },
    {
      "note": "markdown between block HTML tags",
      "md": "<details>\n<summary>S</summary>\n\n- a\n\n</details>\n",
      "html": "<details><summary>S</summary><ul><li>a</li></ul></details>"
    },
    {
      "note": "markdown inside an inline tag",
      "md": "<b>*x*</b>\n",
      "html": "<p><b><em>x</em></b></p>"
    },
    {
      "note": "a table cell unescapes a pipe",
      "md": "| a |\n|---|\n| x \\| y |\n",
      "html": "<table><thead><tr><th>a</th></tr></thead><tbody><tr><td>x | y</td></tr></tbody></table>"
    },
    {
      "note": "a footnote definition ends the paragraph before it",
      "md": "para\n[^1]: def\n\nx[^1]\n",
      "html": "<p>para</p><p>x<sup class=\"footnote-ref\"><a href=\"#fn-1\" id=\"user-content-fnref-1\">1</a></sup></p><section class=\"footnotes\"><ol><li id=\"user-content-fn-1\"><p>def <a class=\"footnote-backref\" href=\"#fnref-1\">↩</a></p></li></ol></section>"
    },
    {
      "note": "back-to-back footnote definitions",
      "md": "[^1]: a\n[^2]: b\n\nx[^1] y[^2]\n",
      "html": "<p>x<sup class=\"footnote-ref\"><a href=\"#fn-1\" id=\"user-content-fnref-1\">1</a></sup> y<sup class=\"footnote-ref\"><a href=\"#fn-2\" id=\"user-content-fnref-2\">2</a></sup></p><section class=\"footnotes\"><ol><li id=\"user-content-fn-1\"><p>a <a class=\"footnote-backref\" href=\"#fnref-1\">↩</a></p></li><li id=\"user-content-fn-2\"><p>b <a class=\"footnote-backref\" href=\"#fnref-2\">↩</a></p></li></ol></section>"
    },
    {
      "note": "a footnote label is href-escaped",
      "md": "x[^é]\n\n[^é]: e\n",
      "html": "<p>x<sup class=\"footnote-ref\"><a href=\"#fn-%C3%A9\" id=\"user-content-fnref-%C3%A9\">1</a></sup></p><section class=\"footnotes\"><ol><li id=\"user-content-fn-%C3%A9\"><p>e <a class=\"footnote-backref\" href=\"#fnref-%C3%A9\">↩</a></p></li></ol></section>"
    },
    {
      "note": "a footnote definition's lazy line",
      "md": "x[^1]\n\n[^1]: a\nlazy\n",
      "html": "<p>x<sup class=\"footnote-ref\"><a href=\"#fn-1\" id=\"user-content-fnref-1\">1</a></sup></p><section class=\"footnotes\"><ol><li id=\"user-content-fn-1\"><p>a lazy <a class=\"footnote-backref\" href=\"#fnref-1\">↩</a></p></li></ol></section>"
    },
    {
      "note": "a footnote holding a list",
      "md": "a[^1]\n\n[^1]: intro\n    - one\n    - two\n",
      "html": "<p>a<sup class=\"footnote-ref\"><a href=\"#fn-1\" id=\"user-content-fnref-1\">1</a></sup></p><section class=\"footnotes\"><ol><li id=\"user-content-fn-1\"><p>intro</p><ul><li>one</li><li>two</li></ul><a class=\"footnote-backref\" href=\"#fnref-1\">↩</a></li></ol></section>"
    },
    {
      "note": "a footnote reference in a table cell",
      "md": "| a |\n|---|\n| x[^1] |\n\n[^1]: d\n",
      "html": "<table><thead><tr><th>a</th></tr></thead><tbody><tr><td>x<sup class=\"footnote-ref\"><a href=\"#fn-1\" id=\"user-content-fnref-1\">1</a></sup></td></tr></tbody></table><section class=\"footnotes\"><ol><li id=\"user-content-fn-1\"><p>d <a class=\"footnote-backref\" href=\"#fnref-1\">↩</a></p></li></ol></section>"
    },
    {
      "note": "a footnote label with a space is a link reference",
      "md": "a[^My Note]\n\n[^my note]: def\n",
      "html": "<p>a<a href=\"def\">^My Note</a></p>"
    }
  ]
}
