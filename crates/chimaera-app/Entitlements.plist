<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The app binary also runs the daemon. Wasmtime 49 publishes plugin
         code with mmap/mprotect, not MAP_JIT, so allow-jit alone is insufficient. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Voice dictation's microphone: the hardened runtime denies audio
         input without it (Info.plist carries the usage description). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
