/target
node_modules/
web-ui/dist/
# Plugin layouts (scripts/build-plugins.sh); the plugins workspace has its own
# target dir. The cache holds the locked releases' downloads; the local
# override points the build at a plugin checkout on this machine.
plugins/dist/
plugins/dist-test/
plugins/target/
plugins/cache/
plugins/plugins.local.toml
# The native shell is a standalone cargo workspace (Tauri stays out of the
# daemon workspace), so it has its own target dir.
crates/chimaera-app/target/
crates/chimaera-app/gen/
*.log
.DS_Store
.claude/scheduled_tasks.lock
.claude/worktrees/
# Isolated per-worktree daemon state (chimaerad-isolated / serve-isolated.sh).
# The isolated app (app-dev-isolated) lives under ~/.chimaera-dev-app, out of the
# repo — its sockets must stay under the ~104-byte sun_path limit (see the skill).
.chimaera-dev/
verify-tmp/
.claude/settings.local.json
