+      // CodeMirror caret would be), then the engine's own forward/backward
+      // visually-distinct-candidate search.
+      const layer = document.querySelector(".layer.active");
+      let lastText: Text | null = null;
+      if (layer !== null) {
+        const tw = document.createTreeWalker(layer, NodeFilter.SHOW_TEXT);
+        while (tw.nextNode()) lastText = tw.currentNode as Text;
+      }
+      let wf = -1;
+      let wb = -1;
+      if (sel !== null && lastText !== null) {
+        const w0 = performance.now();
+        sel.collapse(lastText, lastText.length);
+        sel.modify("move", "forward", "character");
+        wf = performance.now() - w0;
+        const w1 = performance.now();
+        sel.collapse(lastText, 0);
+        sel.modify("move", "backward", "character");
+        wb = performance.now() - w1;
+      }
+      if (ae instanceof HTMLElement) ae.focus();
+      lines.push(`${new Date().toISOString()} switch->${idx} ${dt.toFixed(1)}ms walk fwd ${wf.toFixed(1)}ms back ${wb.toFixed(1)}ms active=${ae?.tagName}.${(ae as HTMLElement)?.className ?? ""}`);
+      if (i % 4 === 3) void write();
+      await sleep(3000);
+    }
+    // Back into the first parked document: is its scroll position intact, and
+    // what does the reveal cost?
+    if (fileIdx.length > 0) {
+      const t0 = performance.now();
+      layout = activateTab(layout, paneId, fileIdx[0]);
+      await tick();
+      await frame();
+      const sc = scroller();
+      lines.push(`reveal file ${fileIdx[0]} ${(performance.now() - t0).toFixed(1)}ms scrollTop=${sc?.scrollTop ?? "n/a"}`);
+    }
+    lines.push("done");
+    await write();
   }
 
